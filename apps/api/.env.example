NODE_ENV=development
PORT=4000

# Matches docker-compose.yml at the repo root
DATABASE_URL="postgresql://skillswap:skillswap@localhost:5432/skillswap?schema=public"
REDIS_URL="redis://localhost:6379"

# Must be at least 32 characters. Generate one in PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
SESSION_SECRET="replace-me-with-a-long-random-string-of-48-chars"

# Where the React + Vite client runs (needed for CORS + cookies)
WEB_ORIGIN="http://localhost:5173"
