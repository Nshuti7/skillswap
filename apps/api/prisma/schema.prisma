// SkillSwap data model, v1 draft. Run `pnpm db:migrate` after editing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums. Keep in sync with packages/shared/src/index.ts.

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum PortfolioStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Proficiency {
  LEARNING
  INTERMEDIATE
  EXPERT
}

enum SkillType {
  TEACH
  LEARN
}

enum SkillRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum SwapSessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ReviewRole {
  MENTOR
  LEARNER
}

enum FlagStatus {
  OPEN
  RESOLVED
}

// Identity and profile

model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique
  passwordHash    String          @map("password_hash")
  name            String
  bio             String?
  skillLevel      SkillLevel      @default(BEGINNER) @map("skill_level")
  portfolioUrl    String?         @map("portfolio_url")
  portfolioStatus PortfolioStatus @default(PENDING) @map("portfolio_status")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // IUEA verification (SS-13). Pilot is IUEA-only.
  // There is no isVerified column: a user is verified when verifiedAt IS NOT NULL.
  // studentId is unique. Postgres allows many NULLs under a unique index,
  // so unverified users with no studentId do not collide.
  studentId  String?   @unique @map("student_id")
  verifiedAt DateTime? @map("verified_at")

  skills                        UserSkill[]
  sentRequests                  SkillRequest[]      @relation("RequestRequester")
  receivedRequests              SkillRequest[]      @relation("RequestTarget")
  conversationsAsParticipantOne Conversation[]      @relation("ConversationParticipantOne")
  conversationsAsParticipantTwo Conversation[]      @relation("ConversationParticipantTwo")
  messagesSent                  Message[]
  assignmentsGiven              SessionAssignment[]
  uploads                       SessionUpload[]
  reviewsGiven                  Review[]            @relation("ReviewAuthor")
  reviewsReceived               Review[]            @relation("ReviewSubject")
  flagsReported                 Flag[]

  @@map("users")
}

model Skill {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  category    String
  description String?

  userSkills          UserSkill[]
  offeredInRequests   SkillRequest[] @relation("RequestOfferedSkill")
  requestedInRequests SkillRequest[] @relation("RequestRequestedSkill")

  @@map("skills")
}

model UserSkill {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  skillId     String      @map("skill_id") @db.Uuid
  proficiency Proficiency
  type        SkillType
  createdAt   DateTime    @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId, type])
  @@map("user_skills")
}

// Matching
// Swaps are reciprocal (SS-11): the requester teaches offeredSkillId and
// wants to learn requestedSkillId from the target user.
//
// Constraints Prisma cannot express. Both go into the SS-15 migration as raw SQL:
//   1. CHECK (offered_skill_id <> requested_skill_id)
//   2. Partial unique index on
//      (requester_id, target_user_id, offered_skill_id, requested_skill_id)
//      WHERE status = 'PENDING', so the same request cannot be sent twice.
// The API also validates (1) with zod. The rule that the requester lists the
// offered skill as TEACH in UserSkill is enforced in the service layer.

model SkillRequest {
  id               String             @id @default(uuid()) @db.Uuid
  requesterId      String             @map("requester_id") @db.Uuid
  targetUserId     String             @map("target_user_id") @db.Uuid
  offeredSkillId   String             @map("offered_skill_id") @db.Uuid
  requestedSkillId String             @map("requested_skill_id") @db.Uuid
  status           SkillRequestStatus @default(PENDING)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  requester      User          @relation("RequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetUser     User          @relation("RequestTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  offeredSkill   Skill         @relation("RequestOfferedSkill", fields: [offeredSkillId], references: [id])
  requestedSkill Skill         @relation("RequestRequestedSkill", fields: [requestedSkillId], references: [id])
  session        SwapSession?
  conversation   Conversation?

  @@index([targetUserId, status])
  @@index([requesterId, status])
  @@map("skill_requests")
}

// Communication
//
// SS-12 decisions:
// 1. Tied to swap: a conversation belongs to exactly one SkillRequest
//    (requestId required + unique, created when the request is accepted).
//    No free messaging between arbitrary users for the pilot (spam/abuse).
//    SwapSession is 1-1 with SkillRequest, so linking the request covers
//    the session without a redundant second FK.
// 2. Two participants only: participantOneId / participantTwoId FKs to User.
//    No ConversationParticipant join table. Matches the MVP; group chat
//    would need a join-table migration later.
//    These two columns duplicate the request's requesterId / targetUserId on
//    purpose. Reading a user's inbox has to filter on "am I in this thread",
//    and going through skill_requests for that costs a join on every query.
//    Denormalised so [participantId, lastMessageAt] can serve the inbox from
//    one index. The service layer owns keeping them in step with the request.
// 3. No soft delete on messages for the pilot: messages are hard-deleted via
//    Cascade when the conversation goes away. Revisit if moderation needs it.
//
// Constraints Prisma cannot express. These go into the SS-15 migration as raw SQL:
//   1. CHECK (participant_one_id <> participant_two_id)
//   2. CHECK (char_length(body) > 0) on messages, so a whitespace-only body
//      cannot be stored. The upper bound is the VarChar below.
// Rules that stay in the service layer, because they span tables:
//   1. Both participants must match the request's requester / target.
//   2. A conversation may only be created once the request is ACCEPTED.
//      A CHECK cannot read another table, so this is a zod + service guard,
//      not a database one. Acceptance criteria live on the SS-12 service ticket.

model Conversation {
  id               String   @id @default(uuid()) @db.Uuid
  requestId        String   @unique @map("request_id") @db.Uuid
  participantOneId String   @map("participant_one_id") @db.Uuid
  participantTwoId String   @map("participant_two_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // The inbox sorts on this, not on updatedAt. @updatedAt only fires when the
  // Conversation row itself is written, and inserting a Message does not touch
  // it, so an updatedAt index would have sorted by "last time the row changed"
  // rather than "last message" and the inbox order would have been wrong.
  // Defaults to creation time so a thread with no messages yet still sorts.
  // The service layer must set this in the same transaction as the insert:
  //   prisma.$transaction([message.create(...), conversation.update(...)])
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  request        SkillRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  participantOne User         @relation("ConversationParticipantOne", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwo User         @relation("ConversationParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([participantOneId, lastMessageAt])
  @@index([participantTwoId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  // Nullable so deleting a user does not delete their messages. Cascade here
  // would erase half of the other participant's thread, and the other person
  // did nothing wrong. Restrict would make the user row undeletable instead.
  // SetNull keeps the thread readable; render a null sender as "Deleted user".
  senderId       String?   @map("sender_id") @db.Uuid
  // Bounded on purpose. Postgres text is unlimited, and the only guard in front
  // of it is express.json({ limit: '1mb' }), which caps the whole body rather
  // than this field. Mirror the 2000 in the zod schema so the API rejects an
  // over-long message with a 400 instead of a database error.
  body           String    @db.VarChar(2000)
  createdAt      DateTime  @default(now()) @map("created_at")
  readAt         DateTime? @map("read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Sessions and reviews.
// Named SwapSession, not Session, to keep it distinct from the login session.

model SwapSession {
  id        String            @id @default(uuid()) @db.Uuid
  requestId String            @unique @map("request_id") @db.Uuid
  startedAt DateTime          @default(now()) @map("started_at")
  endedAt   DateTime?         @map("ended_at")
  status    SwapSessionStatus @default(ACTIVE)

  request     SkillRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assignments SessionAssignment[]
  reviews     Review[]
  flags       Flag[]

  @@map("swap_sessions")
}

model SessionAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  givenById   String    @map("given_by") @db.Uuid
  description String
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")

  session SwapSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  givenBy User            @relation(fields: [givenById], references: [id])
  uploads SessionUpload[]

  @@map("session_assignments")
}

model SessionUpload {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  uploadedById String   @map("uploaded_by") @db.Uuid
  filePath     String   @map("file_path")
  submittedAt  DateTime @default(now()) @map("submitted_at")

  assignment SessionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  uploadedBy User              @relation(fields: [uploadedById], references: [id])

  @@map("session_uploads")
}

model Review {
  id             String     @id @default(uuid()) @db.Uuid
  sessionId      String     @map("session_id") @db.Uuid
  reviewerId     String     @map("reviewer_id") @db.Uuid
  reviewedUserId String     @map("reviewed_user_id") @db.Uuid
  role           ReviewRole
  rating         Int // 1-5, enforced in the API with zod
  comment        String?
  createdAt      DateTime   @default(now()) @map("created_at")

  session      SwapSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewer     User        @relation("ReviewAuthor", fields: [reviewerId], references: [id])
  reviewedUser User        @relation("ReviewSubject", fields: [reviewedUserId], references: [id])

  @@unique([sessionId, reviewerId])
  @@map("reviews")
}

model Flag {
  id           String     @id @default(uuid()) @db.Uuid
  sessionId    String     @map("session_id") @db.Uuid
  reportedById String     @map("reported_by") @db.Uuid
  reason       String
  status       FlagStatus @default(OPEN)
  createdAt    DateTime   @default(now()) @map("created_at")
  resolvedAt   DateTime?  @map("resolved_at")

  session    SwapSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reportedBy User        @relation(fields: [reportedById], references: [id])

  @@map("flags")
}
