# Metro cannot resolve react-native's transitive dependencies through PNPM's
# default isolated node_modules layout, so mobile bundling fails without this.
# See https://docs.expo.dev/guides/monorepos/
#
# Trade-off: PNPM no longer isolates packages, so an undeclared import can still
# resolve. List every dependency in the right package.json.
node-linker=hoisted
